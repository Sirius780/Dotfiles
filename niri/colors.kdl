layout {
    focus-ring {
        active-color "#92bbf8"
        inactive-color "#74757a"
        urgent-color   "#ff716c"
    }

    border {
        active-color   "#92bbf8"
        inactive-color "#74757a"
        urgent-color   "#ff716c"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#92bbf8"
        inactive-color "#74757a"
        urgent-color   "#ff716c"
    }

    insert-hint {
        color "#92bbf880"
    }
}

overview {
	backdrop-color "#0c0e12"
}

recent-windows {
    highlight {
        active-color "#92bbf8"
        urgent-color "#ff716c"
    }
}
