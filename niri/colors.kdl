layout {
    focus-ring {
        active-color "#b6b1fa"
        inactive-color "#77747a"
        urgent-color   "#ff6e84"
    }

    border {
        active-color   "#b6b1fa"
        inactive-color "#77747a"
        urgent-color   "#ff6e84"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#b6b1fa"
        inactive-color "#77747a"
        urgent-color   "#ff6e84"
    }

    insert-hint {
        color "#b6b1fa80"
    }
}

overview {
	backdrop-color "#0e0e12"
}

recent-windows {
    highlight {
        active-color "#b6b1fa"
        urgent-color "#ff6e84"
    }
}
