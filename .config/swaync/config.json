{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "ignore-gtk-theme": true,
  "positionX": "right",
  "positionY": "top",
  "control-center-margin-top": 16,
  "control-center-margin-bottom": 16,
  "control-center-margin-right": 16,
  "control-center-margin-left": 16,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "timeout": 10,
  "timeout-low": 5,
  "timeout-critical": 0,
  "fit-to-screen": true,
  "control-center-width": 600,
  "notification-window-width": 600,
  "notification-grouping": false,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": true,
  "hide-on-action": true,
  "relative-timestamps": true,
  "text-empty": "No Notification",

  "widgets": [
    "title",
    "dnd",
    "buttons-grid",
    "notifications",
    "mpris"
   ],

  "widget-config": {
    "title": {
      "text": "Notification Center",
      "clear-all-button": true,
      "button-text": "󰆴 Clear All"
    },
    "notifications": {
      "vexpand": true
    },
    "mpris": {
      "blacklist": ["firefox"],
      "autohide": true,
      "show-album-art": "always",
      "loop-carousel": false
    },
      "buttons-grid": {
      "actions": [
        {
          "label": "󰐥",
          "command": "systemctl poweroff"
        },
        {
          "label": "󰜉",
          "command": "systemctl reboot"
        },
        {
          "label": "󰍃",
          "command": "niri msg action quit --skip-confirmation"
        },
        {
          "label": "󰕾",
          "command": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
          "type": "toggle"
        },
        {
          "label": "󰂯",
          "command": "blueman-manager"
        }
      ]
    }
  }
}
