#!/usr/bin/env bash
# Detener el script inmediatamente si algún comando o script falla/no existe
set -e

# Obtener la ruta absoluta de donde está guardado este bootstrap
YADM_DIR="$(dirname "$(readlink -f "$0")")"

echo "Iniciando scripts de post-instalacion..."

# Ejecutar los scripts modulares directamente
bash "$YADM_DIR/scripts/sudo-feedback.sh"

echo "✔ Instalacion finalizada"
