// All windows
window-rule {
    geometry-corner-radius 2
    tiled-state true
    clip-to-geometry true
    //draw-border-with-background false
    background-effect {
        blur true
        xray false
    }
}

// Aplications floating
window-rule {
    match app-id="^thunar$" title="(Renombrar|Progreso)"
    match app-id="^org.gnome.FileRoller$" title="Comprimir"
    match app-id="^exo-desktop-item-edit$"
    match app-id="^blueman-manager$"
    match app-id="^com.interversehq.qView$"
    match app-id="^mpv$"
    open-floating true
}

// Steam client
window-rule {
    match app-id="^steam$" title="^Steam$"
    open-maximized true
}

// Games
window-rule {
    match app-id="^steam_app"
    //open-fullscreen true
}

// Picture in picture
window-rule {
    match app-id="^zen$" title="^Picture-in-Picture$"
    open-floating true
    default-floating-position x=16 y=16 relative-to="top-right"
}

// Steam notification
window-rule {
    match app-id="^steam$" title=r"^notificationtoasts_\d+_desktop$"
    default-floating-position x=0 y=0 relative-to="bottom-right"
    open-focused false
}
