layout {
	background-color "transparent"

    focus-ring {
        active-color "#d2feae"
        inactive-color "#74766f"
        urgent-color   "#ff7351"
    }

    border {
        active-color   "#d2feae"
        inactive-color "#74766f"
        urgent-color   "#ff7351"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#d2feae"
        inactive-color "#74766f"
        urgent-color   "#ff7351"
    }

    insert-hint {
        color "#d2feae80"
    }
}

overview {
	backdrop-color "#0d0f0a"
}

recent-windows {
    highlight {
        active-color "#d2feae"
        urgent-color "#ff7351"
    }
}
