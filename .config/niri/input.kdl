input {
    keyboard {
        xkb {
            layout "us"
            variant "altgr-intl"
        }
        repeat-delay 600
	repeat-rate 25
    }
    mouse {
        accel-profile "flat"
    }
    warp-mouse-to-focus
    disable-power-key-handling
    focus-follows-mouse max-scroll-amount="30%"
}
cursor {
    xcursor-theme "Vimix-white-cursors"
    xcursor-size 30
    hide-when-typing
    hide-after-inactive-ms 10000
}
