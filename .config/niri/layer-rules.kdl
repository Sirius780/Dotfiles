layer-rule {
    match namespace="^awww-daemon$"
    place-within-backdrop true
}

// BORRAR AL DEJAR DE USAR DANK SHELL
layer-rule {
    match namespace="^quickshell"
    opacity 0.0
}

layer-rule {
    match namespace="^launcher$"
    shadow {
        on
        softness 16
        spread 8
    }
    background-effect {
        blur true
        xray false
    }
}
